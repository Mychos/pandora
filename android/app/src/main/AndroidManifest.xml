<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The fingerprint prompt. The vault itself needs no permission at all. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- The GitHub mirror on the sources screen. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Handing a downloaded release APK to the system's own installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Reading a QR from inside the app. Asked for only when a scan starts. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Pandora"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/ActivityTheme">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The cdylib `cargo ndk` writes into `jniLibs`. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="pandora" />
        </activity>

        <!-- The phone's own autofill. `BIND_AUTOFILL_SERVICE` is the system's: the
             service is exported so the framework can bind it, and that permission
             is what keeps every other app out. No permission is asked for here. -->
        <service
            android:name=".AutofillService"
            android:exported="true"
            android:label="Pandora"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill" />
        </service>

        <!-- The staged APK an update hands to the system installer: a file in the
             app's own directory reaches that process only as a content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
