<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ActivityTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- The app paints its own chrome and draws behind the bars, which is
             what `MainActivity.systemBars` trims to the status bar: the phone's
             navigation bar stays on show. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
