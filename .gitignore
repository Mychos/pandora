/target
/dist
/.cargo/config.toml

# The JVM behind the Android build leaves these two in the working directory
# when it dies: its own state and a replay of it, megabytes each.
hs_err_pid*.log
replay_pid*.log

# Android: the cdylib is built by `cargo ndk`, the rest by Gradle.
/android/app/src/main/jniLibs
/android/app/build
/android/build
/android/.gradle
/android/local.properties

# The key that signs every APK users install as an update: in the repo, it is
# the ability to ship them a malicious one. `keystore.properties` names it for a
# local build and carries its password, so it is as secret as the file itself.
/android/*.jks
/android/*.keystore
/android/pandora-release.jks
/android/keystore.properties
